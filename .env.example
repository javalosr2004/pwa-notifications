# VAPID keys — generate a pair with `npm run gen:vapid`, then paste them here
# (local dev) and into your Vercel project's Environment Variables (production).
# These must stay stable; changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Upstash Redis (durable KV). On Vercel, the native Upstash integration injects
# these automatically — no need to set them by hand. For local dev, create a free
# database at https://upstash.com and copy the REST URL + token from its
# "REST API" section. If omitted, the app uses a non-durable in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
