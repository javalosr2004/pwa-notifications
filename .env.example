# VAPID keys — generate a pair with `npm run gen:vapid`, then paste them here
# (local dev) and into your Vercel project's Environment Variables (production).
# These must stay stable; changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Upstash Redis (durable KV). Create a free database at https://upstash.com,
# then copy the REST URL + token from the database's "REST API" section.
# If these are omitted, the app falls back to a non-durable in-memory store (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
